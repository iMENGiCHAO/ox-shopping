# =====================================================================
# Ox Shopping 环境变量参考
# 复制为 .env 使用：cp .env.example .env
# 未配置的外部服务会自动降级（模拟支付 / 控制台邮件 / 本地存储）
# =====================================================================

# ---------- 基础 ----------
NODE_ENV=development
# 站点对外地址（邮件链接、支付回调使用）
SITE_URL=http://localhost:3000

# ---------- 数据库（PostgreSQL 16）----------
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public

# ---------- Redis（可选：缓存与限流；关闭后降级为内存实现）----------
REDIS_URL=redis://localhost:6379
# true/false，商品列表缓存开关
REDIS_ENABLED=true
# 商品列表缓存秒数
CACHE_TTL=60

# ---------- JWT 认证 ----------
# 生产环境务必替换为随机强密钥：openssl rand -base64 48
# NODE_ENV=production 时默认强制校验密钥强度(弱密钥拒绝启动)；本地演示可显式设 false 跳过
REQUIRE_STRONG_SECRETS=
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
# access token 有效期（默认 15 分钟）
ACCESS_TOKEN_TTL=900
# refresh token 有效期（默认 7 天）
REFRESH_TOKEN_TTL=604800
# 生产环境跨域/共享 Cookie 时设置，如 .example.com
COOKIE_DOMAIN=
# 是否位于可信反向代理之后（生产默认 true：取 X-Forwarded-For 最后一跳）
TRUST_PROXY=true

# ---------- 支付（Stripe）----------
# auto: 配置了 Stripe 密钥则用 Stripe，否则用内置模拟支付（适合本地演示）
# stripe: 强制 Stripe（未配置密钥将报错）
# mock: 强制模拟支付
PAYMENT_MODE=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe 支持的币种（注意：Stripe 不支持 CNY，启用 Stripe 时建议 USD）
CURRENCY=USD

# ---------- 邮件 ----------
# resend | smtp | console（console 仅打印日志，本地开发默认）
MAIL_PROVIDER=console
MAIL_FROM="Ox Shopping <no-reply@ox.example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---------- 文件存储（S3 兼容：AWS S3 / Cloudflare R2 / MinIO）----------
# s3 | local（local 保存到 ./storage 并由 /api/uploads 提供访问）
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ecommerce
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对象存储的公网访问前缀（MinIO 示例：http://localhost:9000/ecommerce）
S3_PUBLIC_URL=
# 是否 path-style 访问（MinIO/R2 需 true）
S3_FORCE_PATH_STYLE=true
# 上传大小上限（字节，默认 10MB）
UPLOAD_MAX_BYTES=10485760

# ---------- 订单与物流 ----------
# 标准运费
SHIPPING_FEE=10
# 满额免运费（0 = 关闭）
FREE_SHIPPING_THRESHOLD=99
# 税率（0-1，如 0.06 = 6%）
TAX_RATE=0
# 未支付订单自动取消时间（秒，默认 30 分钟）
ORDER_EXPIRE_SECONDS=1800

# ---------- 监控（可选）----------
SENTRY_DSN=

# ---------- 日志 ----------
# trace | debug | info | warn | error
LOG_LEVEL=info
