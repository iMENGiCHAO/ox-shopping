# =====================================================================
# Ox Shopping 环境变量参考
# 复制为 .env 使用：cp .env.example .env
# 未配置的外部服务会自动降级（模拟支付 / 控制台邮件 / 本地存储）
# =====================================================================

# ---------- 基础 ----------
NODE_ENV=development
# 站点对外地址（邮件链接、支付回调、hreflang 使用）
SITE_URL=http://localhost:3000
# 【生产必填】站点名称（品牌名）。用于 SEO 标题、发票抬头、邮件主题、支付收银台。
# 留空会回落为占位名「Ox Shopping」；生产环境(REQUIRE_STRONG_SECRETS=true)会因此拒绝启动。
# 运行期真实品牌以后台「站点设置 → 站点名称」为准，本变量只作兜底。
SITE_NAME=

# ---------- 数据库（PostgreSQL 16）----------
# 【生产必填】Postgres 密码：docker-compose 用它同时设置 postgres 容器密码与应用连接串，
# 缺配时 `docker compose up` 会直接拒绝启动。生成：openssl rand -base64 24。
# ⚠️ 密码含 @ : / ? # % 等特殊字符时，下方 DATABASE_URL 里的密码必须 URL 编码，
#    或直接显式提供完整 DATABASE_URL（推荐）。
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public

# ---------- 数据库备份（compose 的 db-backup 侧车）----------
# 每日自动 pg_dump（自定义格式 + gzip + SHA-256）写入命名卷 dbbackups，保留 N 天。
# 卷内文件仍需另行同步到异地对象存储（见 docs/PRODUCTION_CHECKLIST.md）。
BACKUP_RETAIN_DAYS=14

# ---------- Redis（可选：缓存与限流；关闭后降级为内存实现）----------
# ⚠️ 生产必须带密码：启用 Redis 但 URL 无凭据时，REQUIRE_STRONG_SECRETS=true 将拒绝启动。
#    生成密码：openssl rand -hex 24（密码含特殊字符需 URL 编码后填入下方 URL）
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379
# true/false，商品列表缓存开关
REDIS_ENABLED=true
# 商品列表缓存秒数
CACHE_TTL=60
# 确有内网隔离保障、无法给 Redis 设密码时的豁免开关（默认 false，生产不推荐）
ALLOW_PASSWORDLESS_REDIS_IN_PROD=false

# ---------- JWT 认证 ----------
# 生产环境务必替换为随机强密钥：openssl rand -base64 48
# NODE_ENV=production 时默认强制校验密钥强度(弱密钥拒绝启动)；本地演示可显式设 false 跳过
# ⚠️ 留空 = 按 NODE_ENV 自动（production→true）。**不要**在生产写 false：
#    那会一次性关停「弱 JWT 密钥 / mock 免费下单 / 无密码 Redis / 占位品牌」四道 fail-fast 守卫。
REQUIRE_STRONG_SECRETS=
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
# access token 有效期（默认 15 分钟）
ACCESS_TOKEN_TTL=900
# refresh token 有效期（默认 7 天）
REFRESH_TOKEN_TTL=604800
# 生产环境跨域/共享 Cookie 时设置，如 .example.com
COOKIE_DOMAIN=
# 是否位于可信反向代理之后（生产默认 true：取 X-Forwarded-For 最后一跳）
# ⚠️ 部署契约：TRUST_PROXY=true 时必须保证应用端口**不直接对外**
#   （compose 已绑定 127.0.0.1:3000，只允许宿主机反代访问），
#   否则客户端可自带 X-Forwarded-For 伪造来源 IP 绕过按 IP 的限流。
#   反代侧建议覆盖写入：proxy_set_header X-Forwarded-For $remote_addr;
TRUST_PROXY=true

# ---------- 支付（Stripe）----------
# auto: 配置了 Stripe 密钥则用 Stripe，否则用内置模拟支付（适合本地演示）
# stripe: 强制 Stripe（未配置密钥将报错）
# mock: 强制模拟支付
PAYMENT_MODE=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 生产环境守卫：REQUIRE_STRONG_SECRETS=true 且支付模式为 mock 时拒绝启动
# （防止「生产环境静默免费下单」）。演示/测试如需 mock，显式设 true 跳过。
ALLOW_MOCK_PAYMENT_IN_PROD=false
# 支付渠道配置加密主密钥（AES-256-GCM）。后台「支付渠道」保存的密钥用它加密。
# 【生产必须设置】≥32 位随机值：openssl rand -base64 48
# 更换后需在后台重新保存各渠道配置，否则旧密文无法解密。
PAYMENT_CHANNEL_ENC_KEY=dev-payment-channel-enc-key-change-me
# Stripe 支持的币种（注意：Stripe 不支持 CNY，启用 Stripe 时建议 USD）
CURRENCY=USD

# ---------- 邮件 ----------
# resend | smtp | console（console 仅打印日志，本地开发默认）
MAIL_PROVIDER=console
# 发件地址，形如 `品牌名 <no-reply@你的域名>`。留空则由 SITE_NAME + SITE_URL 自动拼出。
# 【生产必填】不要使用 example.com —— 它是 IANA 保留域，从它发信会被收件方拒收。
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# 客服联系方式兜底（后台「站点设置」未填写时使用）。
# 客服邮箱留空则自动取 MAIL_FROM 里的发件地址 —— FAQ、发票、隐私选择页都会引用它，
# 生产环境请填成真实可达的地址。
SUPPORT_EMAIL=
SUPPORT_PHONE=
# console 邮件驱动的落盘目录（默认 <项目>/.mail-out）—— 开发时查看"收到的邮件"
MAIL_OUT_DIR=
# 发票 PDF 使用的中文字体文件路径（默认 public/fonts 下的内置字体）
INVOICE_FONT_PATH=

# ---------- 文件存储（S3 兼容：AWS S3 / Cloudflare R2 / MinIO）----------
# s3 | local（local 保存到 ./storage 并由 /api/uploads 提供访问）
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ecommerce
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对象存储的公网访问前缀（MinIO 示例：http://localhost:9000/ecommerce）
S3_PUBLIC_URL=
# 是否 path-style 访问（MinIO/R2 需 true）
S3_FORCE_PATH_STYLE=true
# 上传大小上限（字节，默认 10MB）
UPLOAD_MAX_BYTES=10485760

# ---------- 订单与物流 ----------
# 标准运费
SHIPPING_FEE=10
# 满额免运费（0 = 关闭）
FREE_SHIPPING_THRESHOLD=99
# 税率（0-1，如 0.06 = 6%）
TAX_RATE=0
# 未支付订单自动取消时间（秒，默认 30 分钟）
ORDER_EXPIRE_SECONDS=1800

# ---------- 账号安全 ----------
# bcrypt 成本因子（4-15，默认 12）。
# 12 在快机上约 250ms/次；慢机器（含外置卷/低配 VPS）可能到数秒，
# 会直接拖慢登录与注册 —— 请按机器实测调整。
# 生产环境低于 10 会拒绝启动（弱哈希约等于明文存储）。
BCRYPT_ROUNDS=12

# ---------- 后台定时任务（进程内调度，无需外部 cron）----------
# false 可完全关闭：订单过期取消 / 令牌清理 / 掉单对账
CRON_ENABLED=true
# 调度心跳间隔（秒，默认 60）
CRON_INTERVAL_SECONDS=60

# ---------- 监控（可选）----------
SENTRY_DSN=

# ---------- 日志 ----------
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---------- 分销 / 多级佣金（隔离模块，可整体关闭）----------
# false = 完全关闭：代理层不写推广 cookie、注册/下单/支付/退款不再调用分销钩子、
#         分销 API 全部 404、后台与个人中心入口不显示。商城行为与未装该模块完全一致。
# 未设置 = 默认开启。
DISTRIBUTION_ENABLED=true
# 允许超过 3 级的返佣层级（合规上限默认 3 级，见 src/lib/distribution/contract.ts；
# 仅在法律侧确认多级分销合规性后才开启）
DISTRIBUTION_ALLOW_DEEP_LEVELS=false

# ---------- 时区（可选）----------
# 容器进程时区；一路默认 UTC，数据库时间戳不受影响，仅影响日志/定时任务的本地时间口径
#TZ=UTC
# 应用层显式记录的时区（与 TZ 保持一致即可）
#APP_TIMEZONE=UTC

# ---------- 启动种子（可选，危险项）----------
# true = 容器启动时写入演示种子数据（仅本地演示用）
# 生产必须保持 false，否则每次部署都可能重置运营数据
#SEED_ON_START=false

# ---------- Sentry 细化（可选，SENTRY_DSN 配置后才需要）----------
#SENTRY_ENVIRONMENT=production
#SENTRY_TRACES_SAMPLE_RATE=0.1
#SENTRY_RELEASE=

# 运行指标端点 /api/metrics 的 Bearer token（Prometheus 抓取用）。
# 留空 = 端点返回 404（默认不暴露）。
METRICS_TOKEN=
