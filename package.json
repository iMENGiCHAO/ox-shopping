{
  "name": "ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "生产级全栈电商网站：Next.js 16 + TypeScript + Prisma + PostgreSQL + Redis + Stripe + S3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "migrate:payment-channels": "tsx scripts/migrate-payment-channels.ts",
    "db:backfill-descriptions": "tsx scripts/backfill-descriptions.ts",
    "db:studio": "prisma studio",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "postinstall": "prisma generate",
    "db:backup": "bash scripts/backup-db.sh",
    "preflight": "tsx scripts/preflight-check.ts",
    "preflight:dev": "NODE_ENV=development tsx scripts/preflight-check.ts",
    "qa:design": "node scripts/design-assertions.cjs",
    "qa:hardcode": "node scripts/qa/qa-hardcode.mjs",
    "qa:error-lang": "node scripts/qa/qa-error-lang.mjs",
    "qa:a11y": "node scripts/qa/qa-a11y.mjs",
    "qa:mobile": "node scripts/qa/qa-mobile.mjs",
    "qa:links": "node scripts/qa/qa-links.mjs",
    "qa:links:static": "node scripts/qa/qa-links-static.mjs",
    "qa:lang": "node scripts/qa/qa-lang.mjs",
    "qa:sweep": "node scripts/qa/qa-sweep.mjs",
    "qa:layout": "node scripts/qa/qa-layout.mjs",
    "qa:probe": "node scripts/qa/qa-probe-geometry.mjs",
    "qa:static": "npm run qa:hardcode && npm run qa:error-lang && npm run qa:links:static",
    "verify": "npm run typecheck && npm run qa:static && npm run test:unit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.685.0",
    "@aws-sdk/s3-request-presigner": "^3.685.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^1.4.0",
    "@sentry/node": "^10.71.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ioredis": "^5.4.1",
    "isomorphic-dompurify": "^2.16.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "next": "16.3.3",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^1.7.0",
    "stripe": "^16.12.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "knip": "^6.37.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "qs": "^6.16.0"
  }
}
