# 集成测试环境（vitest 集成测试专用库）
NODE_ENV=test
SITE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres@localhost:5432/ecommerce_test?schema=public

REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

PAYMENT_MODE=mock
CURRENCY=CNY

MAIL_PROVIDER=console
MAIL_FROM="星辰商城 <no-reply@example.com>"

STORAGE_DRIVER=local
UPLOAD_MAX_BYTES=10485760

SHIPPING_FEE=10
FREE_SHIPPING_THRESHOLD=99
TAX_RATE=0
ORDER_EXPIRE_SECONDS=1800

SENTRY_DSN=
LOG_LEVEL=warn

# bcrypt 成本因子：集成测试每个文件都要登录，12 轮在本机单次约 5.8s，
# 会把整轮套件拖长数分钟并触发 hookTimeout。测试用 4 轮。
# 生产环境低于 10 轮会拒绝启动（见 src/lib/auth/password.ts）。
BCRYPT_ROUNDS=4
