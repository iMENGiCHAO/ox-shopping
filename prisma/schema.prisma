// Prisma Schema — 生产级电商数据模型
// 说明：在需求模型基础上补充了三个支撑模型：
//   RefreshToken —— JWT refresh token 轮换与重放检测
//   SiteSetting   —— 管理端“设置”页面持久化（站点名称、SEO 等）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

enum Role {
  ADMIN
  CUSTOMER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

/// 折扣码类型：
///  - PERCENTAGE：按折前小计打折（value=1..100 的百分数，可用 maxDiscount 封顶）
///  - FIXED：固定减免金额（value 为基础币种 USD 金额）
///  - FREE_SHIPPING：免运费（value 忽略，减免额 = 订单运费）
enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ============ 用户 ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  /// 注销申请时间（有值=申请处理中；admin 处理完成/驳回后清空）
  deletionRequestedAt DateTime?

  addresses  Address[]
  cartItems  CartItem[]
  orders     Order[]         @relation("UserOrders")
  assignedOrders Order[]     @relation("OrderAssignee")
  refunds    Refund[]
  couponRedemptions CouponRedemption[]
  auditLogs  AuditLog[]
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@index([status])
  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  recipientName String
  phone        String
  province     String
  city         String
  district     String
  detail       String
  /// 街道地址第二行（公寓/单元号）。结账页「Save this information for next time」写入。
  line2        String?
  /// 国家/地区 ISO alpha-2。历史数据为 null（当时只有国内地址）。
  country      String?
  /// 邮编。历史数据为 null。
  postalCode   String?
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256(refresh token)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String? // 轮换后指向新 token id，用于重放检测

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============ 商品 ============

model Category {
  id        String  @id @default(cuid())
  name      String  // zh (fallback when nameEn is null)
  nameEn    String? // optional English name
  slug      String  @unique
  description String?
  /// 首页横幅图（首页两块半宽 Collection 横幅取此图；也是落地页大横幅的兜底）
  image     String?
  /// `/collections` 集合卡片图。为空时回落到 `image`。
  /// 原站首页横幅是模特大片、集合卡片是灰底商品图 —— 两者不同，故单独一列，
  /// 避免为了对齐集合卡片而改坏首页横幅。
  cardImage String?
  /// 落地页顶部全宽大横幅(与列表卡片 image 相互独立)
  bannerImage String?
  parentId  String?
  sortOrder Int     @default(0)
  /// 首页横幅顺序。非空 = 该集合出现在首页那两块半宽横幅里，值即左右次序（1=左，2=右）。
  ///
  /// 为什么与 `sortOrder` 分开：原站首页横幅是 `[ X Collection ]` + `[ SpaceXAI Collection ]`，
  /// 而 `/collections` 的陈列顺序是 `Mens · SpaceXAI Collection · Womens · X Collection`
  /// —— 两者顺序本就不同，用同一个字段无法同时表达。
  homeSortOrder Int?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  /// 以本分类为**主分类**的商品（每件商品恰好一个主分类）
  products Product[]
  /// 集合成员关系（多对多）—— 一件商品可同时出现在多个集合里
  memberships ProductCollection[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

/// 商品 ↔ 集合 的多对多归属。
///
/// 为什么需要它：shop.x.com 的「collection」与「product_type」是两个概念。
/// 原站 /collections 有 4 个集合（Mens / SpaceXAI Collection / Womens / X Collection），
/// 且同一件商品可同时属于多个 —— 实测 `/collections/mens` 里既有 X 线的
/// `The Core Tee` 也有 xAI 线的 `Grok Logo Tee`。单一的 `Product.categoryId`
/// 表达不了这种重叠归属，故引入本表。
///
/// 归属判定统一走 `isInCollection()` / `collectionMembershipWhere()`
/// （`src/server/services/product.service.ts`）：
///   「主分类命中」∪「本表存在成员行」
model ProductCollection {
  productId  String
  categoryId String
  /// 集合内陈列顺序（原站按 /products.json 的先后；同序时回落 createdAt）
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_collections")
}

model Product {
  id            String        @id @default(cuid())
  name          String  // zh (fallback when nameEn is null)
  nameEn        String? // optional English name
  slug          String        @unique
  description   String  // zh description
  descriptionEn String? // optional English description
  sku           String        @unique
  price         Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?     @db.Decimal(10, 2)
  costPrice     Decimal?      @db.Decimal(10, 2)
  stock         Int           @default(0)
  soldCount     Int           @default(0)
  /// 预售：售罄后仍可下单（Pre-Order），前台展示预售标签
  isPresale     Boolean       @default(false)
  /// 预售提示文案（多语言，可选）。为空时使用站级默认（SiteSetting: presale_note_zh/en）。
  presaleNoteZh String?
  presaleNoteEn String?
  /// 运营标签：新品上市 / 热卖（前台徽标）
  isNew         Boolean       @default(false)
  isHot         Boolean       @default(false)
  /// 尺码参数表（官方 Size Chart）：{ headers: string[]; rows: string[][] }
  sizeChart     Json?
  /// 规格级库存：{ "Size": { "S": 3, "M": 0 } }，值为 0 = 该规格售罄
  specStock     Json?
  images        Json          @default("[]") // string[]
  attributes    Json          @default("[]") // { name: string; values: string[] }[]
  status        ProductStatus @default(DRAFT)
  categoryId    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category     @relation(fields: [categoryId], references: [id])
  /// 附加集合归属（多对多）—— 与 `categoryId`（主分类）取并集构成完整归属
  collections ProductCollection[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, createdAt])
  @@index([price])
  @@map("products")
}

// ============ 购物车 ============

model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  // 下单规格快照（[{ name, value }]，如颜色=曜石黑）
  attributes    Json?
  // 规格去重键（规范化 JSON，用于区分同商品不同规格的购物车行）
  attributesKey String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, attributesKey])
  @@index([userId])
  @@map("cart_items")
}

// ============ 订单 ============

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  /// 下单用户；游客结账时为 null（此时联系邮箱见 contactEmail）
  userId          String?
  /// 订单联系邮箱：登录单取用户邮箱，游客单取结账页填写的邮箱。
  /// 用于订单确认/发货/退款邮件，以及游客订单查询与每人限次券的统计口径。
  contactEmail    String?
  /// 游客订单查询令牌（登录单为 null）。订单详情页 /orders/[n]?token=xxx 凭此访问。
  accessToken     String?     @unique
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  /// 使用的折扣码 id / 券码快照（券被删改后订单仍可还原当时的优惠）
  couponId        String?
  couponCode      String?
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("USD")
  // 汇率快照：订单创建时 1 USD 兑订单币种的汇率，确保已结算订单金额不再随汇率变动
  exchangeRate    Decimal     @default(1) @db.Decimal(12, 6)
  addressSnapshot Json // { recipientName, phone, province, city, district, detail }
  paymentProvider String? // stripe | mock
  paymentId       String? // Stripe PaymentIntent id
  // 支付会话 ID（Stripe Checkout Session，掉单对账用预留字段；mock 模式为空）
  paymentSessionId String?
  trackingCompany String?
  trackingNumber  String?
  note            String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  // 物流方式（多对多 1：实际选一种；后台管理；nullable=沿用默认值）
  shippingMethodId String?
  // 运费到付（货到付款）时为 true，shippingFee 仅作占位记录
  isCashOnDelivery Boolean   @default(false)
  // 运营节点：被某个 admin/support 认领处理（防止多端重复处理 / 漏处理）
  assigneeId       String?
  assignedAt       DateTime?
  // 新订单提醒：true = 还没被任何人看过，admin 进入 /orders 列表后自动取消
  isUnread         Boolean   @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user           User?             @relation("UserOrders", fields: [userId], references: [id])
  coupon         Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  refunds        Refund[]
  couponRedemptions CouponRedemption[]
  shippingMethod ShippingMethod?   @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  assignee       User?             @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orderNumber])
  @@index([couponId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([paymentId])
  @@index([paymentSessionId])
  @@index([assigneeId])
  @@index([isUnread, status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  // 下单规格快照（[{ name, value }]）
  attributes   Json?
  sku          String
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)
  // 实际从商品库存扣减的数量（预售可少于 quantity，取消时精确回补）
  stockDeducted Int    @default(0)
  // 实际从规格库存(specStock)扣减的映射 { "组名/值": n }（取消时精确回补）
  specDeducted  Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============ 退款 ============

model Refund {
  id        String       @id @default(cuid())
  orderId   String
  /// 申请退款的用户；游客订单（Order.userId 为空）时为 null
  userId    String?
  reason    String
  amount    Decimal      @db.Decimal(10, 2)
  status    RefundStatus @default(REQUESTED)
  adminNote String?
  // 支付网关退款单号（Stripe refund.id；mock 为空）
  gatewayRefundId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
  @@index([userId])
  @@map("refunds")
}

// ============ 审计日志 ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============ 站点设置 ============

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// 支付渠道（可配置化 + 密钥加密存储）。
/// config_encrypted = AES-256-GCM 加密后的配置 JSON 字符串，密钥来自环境变量。
model PaymentChannel {
  id              String   @id @default(cuid())
  code            String   @unique // alipay | wechat | mock | stripe ...
  name            String   // 后台/前台显示名
  provider        String   // 对应 PaymentProvider.key 实现
  enabled         Boolean  @default(false)
  configEncrypted String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, sortOrder])
  @@map("payment_channels")
}

/// 支付/退款流水日志（资金对账审计；只追加，不修改）
model PaymentLog {
  id        String   @id @default(cuid())
  orderId   String?
  provider  String // stripe | mock
  /// paid | checkout_created | refund_requested | refunded | refund_rejected | reconcile_paid
  event     String
  amount    Decimal? @db.Decimal(10, 2)
  /// 网关侧单号（payment intent / checkout session / refund id）
  gatewayId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([event, createdAt])
  @@map("payment_logs")
}

/// 到货通知（售罄商品 PDP 的 Notify me 订阅）
model NotifyMe {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(254)
  productId String?
  /// 客户选中的规格（如 {"Color":"Black","Size":"M"}）——补货按变体提醒
  attributes Json?
  status    String    @default("draft") // draft=待通知 notified=已通知
  notifiedAt DateTime?
  /// 订阅时浏览器的语种（"zh" | "en"），用于按用户原语种发到货通知邮件；nullable=未记录
  lang      String?
  createdAt DateTime  @default(now())

  @@unique([email, productId])
  @@index([createdAt])
  @@map("notify_me")
}

/// FAQ 常见问题（后台「FAQ 管理」维护，前台 /pages/faqs 读取）
model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(200)
  answer    String   @db.Text
  /// 英文问答（可空 —— 为空时前台英文站点回落到 question/answer，
  /// 与 Product.name/nameEn 同一套 pickName 语义，避免中文界面漏出英文、反之亦然）
  questionEn String? @db.VarChar(200)
  answerEn   String? @db.Text
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// 物流方式（后台「设置 → 物流方式」维护；前台 checkout 选项）
model ShippingMethod {
  id        String   @id @default(cuid())
  /// 后台唯一代号（默认 "standard" / "express"；自定义如 "sf-next-day"）
  code      String   @unique
  /// 显示名（zh fallback when nameEn is null）
  name      String
  nameEn    String?
  /// 简介（多语）
  description String?
  descriptionEn String?
  /// 基础运费（统一币种，与 env.CURRENCY 挂钩）
  fee       Decimal  @db.Decimal(10, 2) @default(0)
  /// 满 X 金额免运费（0 = 不免邮）
  freeOver  Decimal  @db.Decimal(10, 2) @default(0)
  /// 是否到付（到付订单：fee 不计入 total，到付金额另算）
  isCashOnDelivery Boolean @default(false)
  /// 排序（小的在前）
  sortOrder Int      @default(0)
  /// 是否启用
  isActive  Boolean  @default(true)
  /// 估计送达时间（zh / en 多语）
  etaZh     String?
  etaEn     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([isActive, sortOrder])
  @@map("shipping_methods")
}

/// 站内消息中心（个人中心"消息"页 + 顶栏角标）
///  - type: order | refund | system
///  - 多语 title/body（zh fallback） + 客户 lang 切换显示
///  - unread=true 时算入角标；客户点开后自动 mark read
model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// 消息类型：order | refund | system
  type      String
  /// 标题（zh fallback）
  title     String
  titleEn   String?
  /// 正文（多语；前端按 lang 字段选择）
  body      String
  bodyEn    String?
  /// 跳转链接（绝对/相对）
  link      String?
  /// 元数据（订单号、退款 id、商品 id 等）
  meta      Json?
  isUnread  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUnread])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// 折扣码（优惠券）。金额字段一律以**基础币种 USD** 存储，
/// 下单时按订单币种汇率换算后再从折前小计/运费中扣减，
/// 与 order.service 的「USD 计算 → 换算为用户币种」口径保持一致。
model Coupon {
  id       String     @id @default(cuid())
  /// 券码（统一大写存储，校验时对输入做 trim + upper）
  code     String     @unique
  type     CouponType
  /// PERCENTAGE: 1..100 的百分数；FIXED: 减免金额(USD)；FREE_SHIPPING: 忽略
  value    Decimal    @db.Decimal(10, 2)
  /// 使用门槛：折前小计(USD) 达到该值才可用；0 = 无门槛
  minSpend Decimal    @default(0) @db.Decimal(10, 2)
  /// PERCENTAGE 的最大减免封顶(USD)；null = 不封顶
  maxDiscount Decimal? @db.Decimal(10, 2)
  /// 生效窗口
  startsAt DateTime
  endsAt   DateTime
  /// 总可用次数；0 = 不限量
  usageLimit Int      @default(0)
  /// 已核销次数（订单取消/退款时回补）
  usedCount  Int      @default(0)
  /// 每人可用次数（登录单按 userId、游客单按 contactEmail 统计）；0 = 不限
  perUserLimit Int    @default(1)
  /// 是否在公开领券页展示（false = 仅凭码使用，不对外露出）
  isPublic Boolean    @default(false)
  /// 公开领券页的展示文案（多语，zh fallback）
  title         String?
  titleEn       String?
  description   String?
  descriptionEn String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
  @@index([isActive, startsAt, endsAt])
  @@index([isPublic, isActive])
  @@map("coupons")
}

/// 核销记录：下单时写入，是「每人限次」与「已用次数」的唯一事实来源。
/// 取消/退款时删除记录并回补 Coupon.usedCount，使券可再次使用。
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  /// 登录单的持有人；游客单为 null
  userId         String?
  /// 游客单的统计口径（与 Order.contactEmail 一致）
  email          String?
  orderId        String
  /// 实际减免金额（订单币种）
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 幂等键：同一券对同一订单只能核销一次
  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([couponId, email])
  @@map("coupon_redemptions")
}



/// 联系表单留言 —— 对应原站 `/pages/contact` 的三字段表单（Name / E-mail / Message）。
///
/// 为什么**落库**而不只发邮件：邮件通道可能未配置（`MAIL_PROVIDER=console`
/// 时只打日志）或临时故障，只发邮件会静默丢单。落库保证留言不丢，
/// 后台可随时查看与标记处理进度；邮件通知作为「有人找你」的提醒并行发送。
model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  message String
  /// 提交时的站点语种（zh/en）—— 客服可按用户原语种回复
  lang    String @default("en")
  /// 处理状态：new | read | replied | spam
  status  String @default("new")
  /// 来源入口（contact-page / 其他内嵌表单），便于区分流量
  source  String @default("contact-page")
  /// 提交者 IP（限流与反滥用留痕；生产部署在可信反代后取 XFF 末跳）
  ip      String?
  /// 客服处理备注
  note    String?
  /// 是否已发过「新留言」通知邮件（避免重复打扰）
  notified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("contact_messages")
}
