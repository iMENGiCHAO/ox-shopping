// Prisma Schema — 生产级电商数据模型
// 说明：在需求模型基础上补充了三个支撑模型：
//   RefreshToken —— JWT refresh token 轮换与重放检测
//   SiteSetting   —— 管理端“设置”页面持久化（站点名称、SEO 等）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

enum Role {
  ADMIN
  CUSTOMER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// 找回密码申请状态（原站式人工审批流）：
///   PENDING  = 用户已提交，等待管理员处理
///   APPROVED = 管理员已批准，临时密码已邮件发出（用户须首登改密）
///   REJECTED = 管理员已驳回（原因随邮件告知）
enum PasswordResetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  /// 已审核通过、等待网关退款；此时尚不可冲正佣金或标记订单 REFUNDED
  PENDING
  /// 网关调用失败，可按 nextRetryAt 重试；不可视为已退款
  FAILED
  REJECTED
  REFUNDED
}

enum RefundOutboxStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
}

/// 事务邮件发件 outbox（P1：订单确认/发货/退款邮件此前 fire-and-forget，
/// Resend/SMTP 抖动即永久丢信且无人知晓）。queueMail 先落库再立即试发，
/// 失败按指数退避由 scheduler 自动重试；到重试上限置 FAILED 终态。
enum MailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

/// 折扣码类型：
///  - PERCENTAGE：按折前小计打折（value=1..100 的百分数，可用 maxDiscount 封顶）
///  - FIXED：固定减免金额（value 为基础币种 USD 金额）
///  - FREE_SHIPPING：免运费（value 忽略，减免额 = 订单运费）
enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ============ 用户 ============

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  name                String
  role                Role       @default(CUSTOMER)
  status              UserStatus @default(ACTIVE)
  emailVerified       Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastLoginAt         DateTime?
  /// 注销申请时间（有值=申请处理中；admin 处理完成/驳回后清空）
  deletionRequestedAt DateTime?
  /// 管理员已发放临时密码、等待用户首次改密（true 时会话被强制限制在改密页）
  mustChangePassword  Boolean    @default(false)
  /// 最近一次密码修改时间（改密/临时密码重置均更新；用于风控与后台展示）
  passwordChangedAt   DateTime?

  // ── 分销（隔离模块，仅最小外键；详见文件末尾 Distribution 段） ──
  /// 专属推广码（注册即生成；老用户首次访问推广页时惰性补齐）
  referralCode   String?   @unique
  /// 直属上级（推广人）用户 id
  invitedById    String?
  /// 层级路径快照（展示用；权限判定一律走闭包表，不用它查询）
  distPath       String?
  /// 层级深度（自然流量根=0）
  distLevel      Int       @default(0)
  /// 是否已成为分销商（首次成功推广后自动置 true，无需申请审核）
  isDistributor  Boolean   @default(false)
  /// 首次成功推广时间（自动升级时写入）
  firstPromoteAt DateTime?

  addresses                    Address[]
  cartItems                    CartItem[]
  orders                       Order[]                   @relation("UserOrders")
  assignedOrders               Order[]                   @relation("OrderAssignee")
  refunds                      Refund[]
  couponRedemptions            CouponRedemption[]
  auditLogs                    AuditLog[]
  refreshTokens                RefreshToken[]
  notifications                Notification[]
  passwordResetRequests        PasswordResetRequest[]    @relation("PasswordResetRequester")
  handledPasswordResetRequests PasswordResetRequest[]    @relation("PasswordResetHandler")
  invitedBy                    User?                     @relation("DistributionInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees                     User[]                    @relation("DistributionInviter")
  /// 换绑申请（作为客户/目标上级/原上级/审核人）
  rebindAsCustomer             RebindRequest[]           @relation("RebindCustomer")
  rebindAsTarget               RebindRequest[]           @relation("RebindTarget")
  rebindAsSource               RebindRequest[]           @relation("RebindSource")
  rebindReviewed               RebindRequest[]           @relation("RebindReviewer")
  dailyStats                   DistributionDailyStat[]   @relation("DistributionDailyStat")
  relationsAsAncestor          DistributionRelation[]    @relation("DistributionAncestor")
  relationsAsDescendant        DistributionRelation[]    @relation("DistributionDescendant")
  bindingsAsDistributor        DistributorCustomerBind[] @relation("BindDistributor")
  bindingAsCustomer            DistributorCustomerBind?  @relation("BindCustomer")
  commissionsEarned            CommissionLog[]           @relation("CommissionBeneficiary")
  commissionsGenerated         CommissionLog[]           @relation("CommissionSource")
  distributorAccount           DistributorAccount?
  withdrawals                  WithdrawRecord[]
  auditedWithdrawals           WithdrawRecord[]          @relation("WithdrawAuditor")

  @@index([status])
  @@index([isDistributor])
  @@index([invitedById])
  @@map("users")
}

/// 找回密码申请（原站式闭环）：
///   用户填邮箱提交申请 → 后台待处理列表 → 管理员批准/驳回
///   → 批准：服务端生成强随机临时密码并邮件发出，账号置 mustChangePassword
///   → 用户首次登录被强制改密，改密成功清除标记。
///
/// 为什么落库而不是只发邮件：申请是**人工审批**流程，必须有可查询、可幂等、
/// 可审计的状态载体；只发邮件会让「谁处理了、处理到哪一步」丢失。
model PasswordResetRequest {
  id           String              @id @default(cuid())
  userId       String
  /// 申请时的邮箱快照（用户之后改邮箱不影响历史记录）
  email        String              @db.VarChar(254)
  status       PasswordResetStatus @default(PENDING)
  /// 用户填写的说明（选填，帮助客服甄别身份）
  note         String?             @db.Text
  /// 处理人（ADMIN/SUPPORT）与处理时间
  handledById  String?
  handledAt    DateTime?
  /// 驳回原因（随邮件告知用户）
  rejectReason String?             @db.Text
  /// 提交 IP（风控留痕）
  ip           String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user      User  @relation("PasswordResetRequester", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("PasswordResetHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("password_reset_requests")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  phone         String
  province      String
  city          String
  district      String
  detail        String
  /// 街道地址第二行（公寓/单元号）。结账页「Save this information for next time」写入。
  line2         String?
  /// 国家/地区 ISO alpha-2。历史数据为 null（当时只有国内地址）。
  country       String?
  /// 邮编。历史数据为 null。
  postalCode    String?
  isDefault     Boolean  @default(false)
  /// 内容指纹（sha256 规范化全字段）：防「双击保存=两条相同地址」与脚本灌地址簿。
  /// 既有行迁移后为 NULL（PG unique 对 NULL 不去重，兼容存量数据）；
  /// 新增/编辑时由服务层计算写入，同 userId+同指纹 → P2002 → 服务层转 400。
  contentHash   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 部分唯一索引 addresses_one_default_per_user（PostgreSQL migration 维护）：
  /// `WHERE "isDefault" = true` 时每个 userId 最多一条默认地址。
  @@unique([userId, contentHash])
  @@index([userId])
  @@map("addresses")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256(refresh token)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String? // 轮换后指向新 token id，用于重放检测

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// 心跳清理任务按 expiresAt 批删（scheduler 每 60s）：
  /// 无索引时 20 万用户 × 多设备 token 规模下每分钟全表扫（性能审计修复）。
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============ 商品 ============

model Category {
  id            String   @id @default(cuid())
  name          String // zh (fallback when nameEn is null)
  nameEn        String? // optional English name
  slug          String   @unique
  description   String?
  /// 首页横幅图（首页两块半宽 Collection 横幅取此图；也是落地页大横幅的兜底）
  image         String?
  /// `/collections` 集合卡片图。为空时回落到 `image`。
  /// 原站首页横幅是模特大片、集合卡片是灰底商品图 —— 两者不同，故单独一列，
  /// 避免为了对齐集合卡片而改坏首页横幅。
  cardImage     String?
  /// 落地页顶部全宽大横幅(与列表卡片 image 相互独立)
  bannerImage   String?
  parentId      String?
  sortOrder     Int      @default(0)
  /// 首页横幅顺序。非空 = 该集合出现在首页那两块半宽横幅里，值即左右次序（1=左，2=右）。
  ///
  /// 为什么与 `sortOrder` 分开：原站首页横幅是 `[ X Collection ]` + `[ SpaceXAI Collection ]`，
  /// 而 `/collections` 的陈列顺序是 `Mens · SpaceXAI Collection · Womens · X Collection`
  /// —— 两者顺序本就不同，用同一个字段无法同时表达。
  homeSortOrder Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]          @relation("CategoryTree")
  /// 以本分类为**主分类**的商品（每件商品恰好一个主分类）
  products    Product[]
  /// 集合成员关系（多对多）—— 一件商品可同时出现在多个集合里
  memberships ProductCollection[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

/// 商品 ↔ 集合 的多对多归属。
///
/// 为什么需要它：shop.x.com 的「collection」与「product_type」是两个概念。
/// 原站 /collections 有 4 个集合（Mens / SpaceXAI Collection / Womens / X Collection），
/// 且同一件商品可同时属于多个 —— 实测 `/collections/mens` 里既有 X 线的
/// `The Core Tee` 也有 xAI 线的 `Grok Logo Tee`。单一的 `Product.categoryId`
/// 表达不了这种重叠归属，故引入本表。
///
/// 归属判定统一走 `isInCollection()` / `collectionMembershipWhere()`
/// （`src/server/services/product.service.ts`）：
///   「主分类命中」∪「本表存在成员行」
model ProductCollection {
  productId  String
  categoryId String
  /// 集合内陈列顺序（原站按 /products.json 的先后；同序时回落 createdAt）
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_collections")
}

model Product {
  id             String           @id @default(cuid())
  name           String // zh (fallback when nameEn is null)
  nameEn         String? // optional English name
  slug           String           @unique
  description    String // zh description
  descriptionEn  String? // optional English description
  sku            String           @unique
  price          Decimal          @db.Decimal(10, 2)
  compareAtPrice Decimal?         @db.Decimal(10, 2)
  costPrice      Decimal?         @db.Decimal(10, 2)
  stock          Int              @default(0)
  soldCount      Int              @default(0)
  /// 预售：售罄后仍可下单（Pre-Order），前台展示预售标签
  isPresale      Boolean          @default(false)
  /// 预售提示文案（多语言，可选）。为空时使用站级默认（SiteSetting: presale_note_zh/en）。
  presaleNoteZh  String?
  presaleNoteEn  String?
  /// 运营标签：新品上市 / 热卖（前台徽标）
  isNew          Boolean          @default(false)
  isHot          Boolean          @default(false)
  /// 尺码参数表（官方 Size Chart）：{ headers: string[]; rows: string[][] }
  sizeChart      Json?
  /// 规格级库存：{ "Size": { "S": 3, "M": 0 } }，值为 0 = 该规格售罄
  specStock      Json?
  /// SKU 矩阵（颜色×尺码等组合粒度库存）：非空时**优先于 specStock**——
  /// 组合粒度可表达「不同颜色有不同尺码范围」「每个组合独立库存」，
  /// 维度池模型（specStock）无法表达这两种真实业务场景。
  variants       ProductVariant[]
  images         Json             @default("[]") // string[]
  attributes     Json             @default("[]") // { name: string; values: string[] }[]
  status         ProductStatus    @default(DRAFT)
  categoryId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  category    Category            @relation(fields: [categoryId], references: [id])
  /// 附加集合归属（多对多）—— 与 `categoryId`（主分类）取并集构成完整归属
  collections ProductCollection[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, createdAt])
  /// sitemap 收录查询（P1-3 商用审计）：status=ACTIVE + updatedAt desc top-N，
  /// 无此索引时每次爬虫抓 sitemap.xml 都是全表 seq scan + top-N sort
  @@index([status, updatedAt(sort: Desc)])
  @@index([price])
  @@map("products")
}

// ============ 购物车 ============

model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  // 下单规格快照（[{ name, value }]，如颜色=曜石黑）
  attributes    Json?
  // 规格去重键（规范化 JSON，用于区分同商品不同规格的购物车行）
  attributesKey String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, attributesKey])
  @@index([userId])
  @@map("cart_items")
}

// ============ 订单 ============

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  /// 下单幂等键（客户端 uuid）：防「双击下单=两张单扣两份库存」。NULL 不约束
  /// （存量单与老客户端兼容）；重发命中唯一约束 → 返回首张单（真幂等）。
  idempotencyKey   String?     @unique
  /// 下单用户；游客结账时为 null（此时联系邮箱见 contactEmail）
  userId           String?
  /// 订单联系邮箱：登录单取用户邮箱，游客单取结账页填写的邮箱。
  /// 用于订单确认/发货/退款邮件，以及游客订单查询与每人限次券的统计口径。
  contactEmail     String?
  /// 游客订单查询令牌（登录单为 null）。订单详情页 /orders/[n]?token=xxx 凭此访问。
  accessToken      String?     @unique
  status           OrderStatus @default(PENDING_PAYMENT)
  subtotal         Decimal     @db.Decimal(10, 2)
  shippingFee      Decimal     @default(0) @db.Decimal(10, 2)
  tax              Decimal     @default(0) @db.Decimal(10, 2)
  discount         Decimal     @default(0) @db.Decimal(10, 2)
  /// 使用的折扣码 id / 券码快照（券被删改后订单仍可还原当时的优惠）
  couponId         String?
  couponCode       String?
  total            Decimal     @db.Decimal(10, 2)
  currency         String      @default("USD")
  // 汇率快照：订单创建时 1 USD 兑订单币种的汇率，确保已结算订单金额不再随汇率变动
  exchangeRate     Decimal     @default(1) @db.Decimal(12, 6)
  addressSnapshot  Json // { recipientName, phone, province, city, district, detail }
  paymentProvider  String? // stripe | mock
  paymentId        String? // Stripe PaymentIntent id
  // 支付会话 ID（Stripe Checkout Session，掉单对账用预留字段；mock 模式为空）
  paymentSessionId String?
  trackingCompany  String?
  trackingNumber   String?
  note             String?
  /// 运营内部备注（仅后台可见，不会随邮件发给顾客/不展示在顾客订单页）。
  /// 与 note 分离：note 是顾客下单时填的备注，运营改写会丢失顾客原话。
  adminNote        String?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  refundedAt       DateTime?
  // 物流方式（多对多 1：实际选一种；后台管理；nullable=沿用默认值）
  shippingMethodId String?
  // 运费到付（货到付款）时为 true，shippingFee 仅作占位记录
  isCashOnDelivery Boolean     @default(false)
  /// 货到付款参考金额：顾客在送达时应向承运商支付的到付费（订单 total 之外）。
  /// 仅 COD 订单有值（非 COD 为 null）；total 不含该金额——货到付款的运费不计入在线支付总额，
  /// 落库后仓库/客服可直接从订单看到「送达时应收现金 = total + codFee」。
  codFee           Decimal?    @db.Decimal(10, 2)
  // 运营节点：被某个 admin/support 认领处理（防止多端重复处理 / 漏处理）
  assigneeId       String?
  assignedAt       DateTime?
  // 新订单提醒：true = 还没被任何人看过，admin 进入 /orders 列表后自动取消
  isUnread         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user              User?              @relation("UserOrders", fields: [userId], references: [id])
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  refunds           Refund[]
  couponRedemptions CouponRedemption[]
  shippingMethod    ShippingMethod?    @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  assignee          User?              @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // 分销：归属快照与佣金流水（隔离模块，删除订单时级联清理）
  attribution       OrderAttribution?
  commissions       CommissionLog[]

  @@index([orderNumber])
  @@index([couponId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([paymentId])
  @@index([paymentSessionId])
  @@index([assigneeId])
  @@index([isUnread, status])
  /// 运营默认视图按 [isUnread desc, createdAt desc] 排序：无此索引时
  /// 50 万行 seq scan + top-N sort（性能审计高危）。
  @@index([isUnread, createdAt(sort: Desc)])
  /// 资金口径统计/对账全靠 paidAt 过滤（营收、趋势、reconcile）：
  /// 此前全 schema 无 paidAt 索引，全部 seq scan（性能审计高危）。
  /// PG 单列 b-tree 不含 NULL 行，`paidAt IS NOT NULL` 谓词直接命中。
  @@index([paidAt])
  @@map("orders")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// 组合属性快照 [{ name, value }]（如 [{颜色,红},{尺码,M}]）
  attributes Json
  /// 规范化组合签名（属性按 name 排序拼 "名:值|名:值"）—— 唯一约束防重复组合，
  /// 也是下单时定位变体的索引键（避免 JSON 比较的方言差异）
  signature  String
  stock      Int      @default(0)
  /// 组合级覆盖价（可空 = 用商品价）——支持「大码加价」等真实定价
  price      Decimal? @db.Decimal(10, 2)
  sku        String?
  /// 组合图（可空 = 用商品主图）
  image      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, signature])
  @@index([productId, isActive])
  @@map("product_variants")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  productName     String
  productImage    String?
  // 下单规格快照（[{ name, value }]）
  attributes      Json?
  sku             String
  price           Decimal  @db.Decimal(10, 2)
  quantity        Int
  subtotal        Decimal  @db.Decimal(10, 2)
  // 下单时的商品成本价快照（分销「利润分成」模式的计佣基数用）。
  // 快照而非引用：之后修改成本价不影响已下单订单的利润口径；商品被删后仍可对账。
  costPrice       Decimal? @db.Decimal(10, 2)
  // 实际从商品库存扣减的数量（预售可少于 quantity，取消时精确回补）
  stockDeducted   Int      @default(0)
  // 实际从规格库存(specStock)扣减的映射 { "组名/值": n }（取消时精确回补）
  specDeducted    Json?
  /// 变体模式的扣减凭据 { variantId, qty }（组合粒度回补，与 specDeducted 互斥）
  variantDeducted Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============ 退款 ============

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  /// 申请退款的用户；游客订单（Order.userId 为空）时为 null
  userId          String?
  reason          String
  amount          Decimal      @db.Decimal(10, 2)
  status          RefundStatus @default(REQUESTED)
  adminNote       String?
  // 支付网关退款单号（Stripe refund.id；mock 为空）
  gatewayRefundId String?      @unique
  /// 同一退款在所有重试中共用的渠道幂等键；DB 唯一约束防止重复建 outbox。
  idempotencyKey  String       @unique
  attempts        Int          @default(0)
  lastError       String?      @db.Text
  nextRetryAt     DateTime?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])
  outbox RefundOutbox?

  @@index([orderId])
  @@index([status, createdAt])
  @@index([userId])
  @@map("refunds")
}

/// 退款可靠发件箱：审核通过与「需要向网关退款」在同一事务提交。
/// worker 以 claimedAt 租约领取；每次重试复用 Refund.idempotencyKey。
model RefundOutbox {
  id            String             @id @default(cuid())
  refundId      String             @unique
  status        RefundOutboxStatus @default(PENDING)
  attempts      Int                @default(0)
  /// 同一退款跨重试稳定幂等键；额外唯一约束防重复任务。
  uniqueKey     String             @unique
  nextAttemptAt DateTime           @default(now())
  claimedAt     DateTime?
  lastError     String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("refund_outbox")
}

/// 事务邮件发件队列（at-least-once）：`data` 原样存储调用方 payload，
/// 重放时重新走 sendMail 渲染（siteUrl/siteName/品牌名渲染时注入，
/// 后台改配置后重试的邮件用**新**配置，而非快照旧值）。
/// console 通道 `delivered=false` 同样进入重试（与到货提醒 draft 语义一致：
/// 落盘 ≠ 送达），生产 MAIL_PROVIDER 守卫保证 resend/smtp。
model MailOutbox {
  id            String           @id @default(cuid())
  to            String
  /// 模板 key（MailData 的 key，见 src/lib/mail/index.ts registry）
  template      String
  /// 调用方 payload；lang 字段包含在其中（sendMail 从 data.lang 读取）
  data          Json
  status        MailOutboxStatus @default(PENDING)
  attempts      Int              @default(0)
  /// 重试上限；到限置 FAILED 终态（默认 8 次 ≈ 指数退避累计约 2 小时）
  maxAttempts   Int              @default(8)
  nextAttemptAt DateTime         @default(now())
  claimedAt     DateTime?
  lastError     String?          @db.Text
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  /// 心跳清理按 updatedAt 批删已终态行（scheduler 每 60s）：无索引时倾向
  /// 全表扫（性能审计中危）。
  @@index([updatedAt])
  @@map("mail_outbox")
}

/// Provider webhook 持久幂等账本。签名验证后才允许 claim；lease 让失败/崩溃事件可重试。
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String
  eventId     String
  type        String
  status      WebhookEventStatus @default(PROCESSING)
  attempts    Int                @default(0)
  leaseUntil  DateTime?
  lastError   String?            @db.Text
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([provider, eventId])
  @@index([status, leaseUntil])
  @@map("webhook_events")
}

// ============ 审计日志 ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============ 站点设置 ============

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// 支付渠道（可配置化 + 密钥加密存储）。
/// config_encrypted = AES-256-GCM 加密后的配置 JSON 字符串，密钥来自环境变量。
model PaymentChannel {
  id              String   @id @default(cuid())
  code            String   @unique // alipay | wechat | mock | stripe ...
  name            String // 后台/前台显示名
  provider        String // 对应 PaymentProvider.key 实现
  enabled         Boolean  @default(false)
  configEncrypted String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, sortOrder])
  @@map("payment_channels")
}

/// 支付/退款流水日志（资金对账审计；只追加，不修改）
model PaymentLog {
  id        String   @id @default(cuid())
  orderId   String?
  provider  String // stripe | mock
  /// paid | checkout_created | refund_requested | refunded | refund_rejected | reconcile_paid
  event     String
  amount    Decimal? @db.Decimal(10, 2)
  /// 网关侧单号（payment intent / checkout session / refund id）
  gatewayId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([event, createdAt])
  @@map("payment_logs")
}

/// 到货通知（售罄商品 PDP 的 Notify me 订阅）
model NotifyMe {
  id         String    @id @default(cuid())
  email      String    @db.VarChar(254)
  productId  String?
  /// 客户选中的规格（如 {"Color":"Black","Size":"M"}）——补货按变体提醒
  attributes Json?
  status     String    @default("draft") // draft=待通知 notified=已通知
  notifiedAt DateTime?
  /// 订阅时浏览器的语种（"zh" | "en"），用于按用户原语种发到货通知邮件；nullable=未记录
  lang       String?
  createdAt  DateTime  @default(now())

  @@unique([email, productId])
  @@index([createdAt])
  @@map("notify_me")
}

/// FAQ 常见问题（后台「FAQ 管理」维护，前台 /pages/faqs 读取）
model Faq {
  id         String   @id @default(cuid())
  question   String   @db.VarChar(200)
  answer     String   @db.Text
  /// 英文问答（可空 —— 为空时前台英文站点回落到 question/answer，
  /// 与 Product.name/nameEn 同一套 pickName 语义，避免中文界面漏出英文、反之亦然）
  questionEn String?  @db.VarChar(200)
  answerEn   String?  @db.Text
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

/// 物流方式（后台「设置 → 物流方式」维护；前台 checkout 选项）
model ShippingMethod {
  id               String   @id @default(cuid())
  /// 后台唯一代号（默认 "standard" / "express"；自定义如 "sf-next-day"）
  code             String   @unique
  /// 显示名（zh fallback when nameEn is null）
  name             String
  nameEn           String?
  /// 简介（多语）
  description      String?
  descriptionEn    String?
  /// 基础运费（统一币种，与 env.CURRENCY 挂钩）
  fee              Decimal  @default(0) @db.Decimal(10, 2)
  /// 满 X 金额免运费（0 = 不免邮）
  freeOver         Decimal  @default(0) @db.Decimal(10, 2)
  /// 是否到付（到付订单：fee 不计入 total，到付金额另算）
  isCashOnDelivery Boolean  @default(false)
  /// 排序（小的在前）
  sortOrder        Int      @default(0)
  /// 是否启用
  isActive         Boolean  @default(true)
  /// 估计送达时间（zh / en 多语）
  etaZh            String?
  etaEn            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
  @@map("shipping_methods")
}

/// 站内消息中心（个人中心"消息"页 + 顶栏角标）
///  - type: order | refund | system
///  - 多语 title/body（zh fallback） + 客户 lang 切换显示
///  - unread=true 时算入角标；客户点开后自动 mark read
model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// 消息类型：order | refund | system
  type      String
  /// 标题（zh fallback）
  title     String
  titleEn   String?
  /// 正文（多语；前端按 lang 字段选择）
  body      String
  bodyEn    String?
  /// 跳转链接（绝对/相对）
  link      String?
  /// 元数据（订单号、退款 id、商品 id 等）
  meta      Json?
  isUnread  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUnread])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// 折扣码（优惠券）。金额字段一律以**基础币种 USD** 存储，
/// 下单时按订单币种汇率换算后再从折前小计/运费中扣减，
/// 与 order.service 的「USD 计算 → 换算为用户币种」口径保持一致。
model Coupon {
  id            String     @id @default(cuid())
  /// 券码（统一大写存储，校验时对输入做 trim + upper）
  code          String     @unique
  type          CouponType
  /// PERCENTAGE: 1..100 的百分数；FIXED: 减免金额(USD)；FREE_SHIPPING: 忽略
  value         Decimal    @db.Decimal(10, 2)
  /// 使用门槛：折前小计(USD) 达到该值才可用；0 = 无门槛
  minSpend      Decimal    @default(0) @db.Decimal(10, 2)
  /// PERCENTAGE 的最大减免封顶(USD)；null = 不封顶
  maxDiscount   Decimal?   @db.Decimal(10, 2)
  /// 生效窗口
  startsAt      DateTime
  endsAt        DateTime
  /// 总可用次数；0 = 不限量
  usageLimit    Int        @default(0)
  /// 已核销次数（订单取消/退款时回补）
  usedCount     Int        @default(0)
  /// 每人可用次数（登录单按 userId、游客单按 contactEmail 统计）；0 = 不限
  perUserLimit  Int        @default(1)
  /// 是否在公开领券页展示（false = 仅凭码使用，不对外露出）
  isPublic      Boolean    @default(false)
  /// 公开领券页的展示文案（多语，zh fallback）
  title         String?
  titleEn       String?
  description   String?
  descriptionEn String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
  @@index([isActive, startsAt, endsAt])
  @@index([isPublic, isActive])
  @@map("coupons")
}

/// 核销记录：下单时写入，是「每人限次」与「已用次数」的唯一事实来源。
/// 取消/退款时删除记录并回补 Coupon.usedCount，使券可再次使用。
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  /// 登录单的持有人；游客单为 null
  userId         String?
  /// 游客单的统计口径（与 Order.contactEmail 一致）
  email          String?
  orderId        String
  /// 实际减免金额（订单币种）
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 幂等键：同一券对同一订单只能核销一次
  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([couponId, email])
  @@map("coupon_redemptions")
}

// ═══════════════════════════════════════════════════════════════════════════
// Distribution（分销 / 多级佣金）—— 隔离模块
//
// 设计约束（大爷 2026-09-20 要求「隔离、解耦、接口调用」）：
//   1. 本段所有表以 distribution_ / commission_ / withdraw_ 命名前缀归属同一模块，
//      除 User/Order 上的最小外键字段外，**不改动**商城既有表结构；
//   2. 商城侧只通过 `src/server/services/distribution/bridge.ts` 的接口调用接入，
//      且 `DISTRIBUTION_ENABLED=false` 时整段逻辑与入口全部静默关闭；
//   3. 佣金只与**真实订单**挂钩（每笔都能追溯到 orderId），不做按人头返利。
// ═══════════════════════════════════════════════════════════════════════════

/// 佣金流水状态
enum CommissionStatus {
  /// 待结算：订单已支付，未过退款保障期（不可提现）
  PENDING
  /// 已结算：已过退款保障期/已确认收货，计入可提现余额
  SETTLED
  /// 已冲正：订单退款/取消，金额作废（保留负数流水痕迹）
  REVERSED
}

/// 提现单状态
enum WithdrawStatus {
  /// 待审核
  PENDING
  /// 审核通过（待打款）
  APPROVED
  /// 已打款（线下转账后管理员标记）
  PAID
  /// 已驳回（金额解冻退回余额）
  REJECTED
}

/// 分销商上下级关系闭包表。
///
/// 为什么用闭包表而不是 `parent_id` 递归 / `path LIKE`：
///   - 逐级分佣要「取某人的全部上级」，闭包表一次索引查询拿到（O(深度) 存储换 O(1) 查询）；
///   - `path LIKE '%/id/%'` 的前置通配符在 PostgreSQL 里用不上 B-tree 索引，团队一大就全表扫；
///   - depth=0 是「自己」这一行，使查询无需特判。
model DistributionRelation {
  ancestorId   String
  descendantId String
  /// 0=自己, 1=直接上级, 2=二级…（相对 descendant 而言）
  depth        Int      @default(1)
  createdAt    DateTime @default(now())

  ancestor   User @relation("DistributionAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant User @relation("DistributionDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@map("distribution_relations")
}

/// 客户归属绑定表（客户 → 分销商）。
///
/// `customerId` 唯一：一个客户同时只能归属一个分销商，这是「不可抢绑」的**数据库级**保证
/// —— 应用层判重会被并发穿透，唯一约束不会。
model DistributorCustomerBind {
  id            String    @id @default(cuid())
  /// 可空 + SetNull：任一方注销/删除时不级联删除绑定历史（审计与对账需要）
  distributorId String?
  customerId    String?   @unique
  /// 绑定来源：link（链接）| qrcode（二维码）| code（邀请码）
  bindType      String    @default("link")
  /// 渠道留痕（utm/来源页等）
  source        String?
  bindTime      DateTime  @default(now())
  /// 绑定到期时间；null=永久（默认口径：绑定永久有效）
  expireAt      DateTime?
  /// ACTIVE | RELEASED（解绑后置 RELEASED，便于审计留痕）
  status        String    @default("ACTIVE")
  releasedAt    DateTime?

  distributor User? @relation("BindDistributor", fields: [distributorId], references: [id], onDelete: SetNull)
  customer    User? @relation("BindCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([distributorId, status])
  @@index([status, bindTime])
  @@map("distributor_customer_binds")
}

/// 佣金规则表：按 (scope, level) 配置比例。
/// scope = GLOBAL 时 scopeId 为空；CATEGORY/PRODUCT 时指向分类/商品 id。
/// 团队业绩日粒度汇总（P2-12 预聚合）
///
/// 为什么需要：团队业绩/报表原先每次都实时聚合订单与佣金（`orderAttributions` +
/// `commissionLogs` 分组），团队规模一大、时间窗一长就是全表扫描。
/// 这里按「分销商 × 日」预计算一份小表：dashboard/报表读它，明细页仍读实时表 ——
/// 口径由同一个作业写入，不会出现"报表和明细对不上"。
model DistributionDailyStat {
  id            String   @id @default(cuid())
  /// 统计对象（分销商）
  userId        String
  /// 统计日（归一化到当天 00:00 UTC）
  day           DateTime @db.Date
  /// 当日归属该分销商的订单数与销售额（CNY，按下单时汇率快照折算）
  orders        Int      @default(0)
  salesCny      Decimal  @default(0) @db.Decimal(12, 2)
  /// 当日产生的佣金（CNY，含在途与已结算；冲正金额不计入）
  commissionCny Decimal  @default(0) @db.Decimal(12, 2)
  /// 汇总时刻的团队人数快照（趋势用）
  teamSize      Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation("DistributionDailyStat", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("distribution_daily_stats")
}

/// 换绑审核申请（allowRebind=true 时，换绑必须经平台审核，不再自动生效）
model RebindRequest {
  id                String    @id @default(cuid())
  /// 被换绑的客户
  customerId        String
  /// 原上级（可能为空=自然流量客户）
  fromDistributorId String?
  /// 目标上级
  toDistributorId   String
  /// PENDING | APPROVED | REJECTED
  status            String    @default("PENDING")
  /// 申请人/发起来源备注
  requestedNote     String?
  reviewedById      String?
  reviewNote        String?
  createdAt         DateTime  @default(now())
  reviewedAt        DateTime?

  customer        User  @relation("RebindCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  toDistributor   User  @relation("RebindTarget", fields: [toDistributorId], references: [id], onDelete: Cascade)
  fromDistributor User? @relation("RebindSource", fields: [fromDistributorId], references: [id], onDelete: SetNull)
  reviewedBy      User? @relation("RebindReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([customerId])
  @@map("rebind_requests")
}

model CommissionRule {
  id          String    @id @default(cuid())
  /// GLOBAL | CATEGORY | PRODUCT
  scopeType   String    @default("GLOBAL")
  scopeId     String?
  /// 分佣层级（1=一级）
  level       Int
  /// RATIO = 按比例（用 ratio）；FIXED = 固定金额（用 fixedAmount，订单币种）
  mode        String    @default("RATIO")
  /// 比例百分数：10.00 表示 10%（mode=RATIO 时生效）
  ratio       Decimal   @default(0) @db.Decimal(5, 2)
  /// 固定金额（订单币种，mode=FIXED 时生效）：如"每单固定返 5 美元"
  fixedAmount Decimal?  @db.Decimal(10, 2)
  /// 仅对指定等级的分销商生效；**0 = 通用规则**（对该层所有分销商生效）。
  ///
  /// ⚠️ 为什么是 0 而不是 null：唯一键必须能区分「通用」与「某等级」两种规则。
  /// PostgreSQL 的唯一索引里 NULL 互不相等 —— 若用 null 表示通用，
  /// 同 (scope, level) 的通用规则可以重复插入，而「等级专用规则」又会与通用规则
  /// 撞同一个唯一键（互相覆盖），最终表现为**该层级佣金静默归零**（P0-1）。
  tierLevel   Int       @default(0)
  enabled     Boolean   @default(true)
  effectiveAt DateTime?
  expireAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// 唯一键含 tierLevel：同一作用域同一层级下，「通用规则」与「各等级专用规则」并存
  @@unique([scopeType, scopeId, level, tierLevel])
  @@index([enabled, level])
  @@map("commission_rules")
}

/// 佣金流水（只追加，不修改金额；冲正=改状态并把痕迹留在 reversedAt/note）。
/// 幂等键 `(orderId, toUserId, level)`：重复回调/并发补算都不会重复计佣。
model CommissionLog {
  id             String           @id @default(cuid())
  orderId        String
  /// 预留：按订单项计佣时使用（MVP 为整单口径，恒为 null）
  orderItemId    String?
  /// 下单用户（自购时 = toUserId 的下一级来源，便于风控识别自购）
  fromUserId     String?
  /// 获得佣金的人。
  /// **可空**：用户注销/被删除时置 NULL（onDelete: SetNull），佣金流水必须留存
  /// —— 财务对账与法律留痕要求「钱走过就要有记录」，级联删除会把账本删掉。
  /// 展示用姓名/邮箱走下面的冗余快照字段（删除用户后仍可对账）。
  toUserId       String?
  level          Int
  ratio          Decimal          @db.Decimal(5, 2)
  /// 佣金金额（订单币种）
  amount         Decimal          @db.Decimal(10, 2)
  /// 折合人民币（历史兼容列：统一审计口径）
  amountCny      Decimal          @db.Decimal(12, 2)
  /// 结算币种（受益人分销账户的 settlementCurrency，计提时快照）
  settleCurrency String           @default("CNY")
  /// 按结算币种折算的佣金（账户入账/提现的记账金额；计提时按汇率快照固化）
  amountSettle   Decimal          @default(0) @db.Decimal(12, 2)
  currency       String           @default("CNY")
  /// 计佣基数快照（订单币种）：销售额模式=商品实付小计（不含运费/税）；
  /// 利润模式=Σ(行实付分摊 − 成本快照)，见 commission.service 的 baseAmountForOrder。
  baseAmount     Decimal          @default(0) @db.Decimal(10, 2)
  status         CommissionStatus @default(PENDING)
  /// 累计已冲正金额（订单币种）。部分退款按比例冲正时是**增量累计**，
  /// 与 `amount` 相等即视为全额冲正（status=REVERSED）。
  reversedAmount Decimal          @default(0) @db.Decimal(10, 2)
  /// 累计已冲正金额（CNY），与 reversedAmount 同步推进
  reversedCny    Decimal          @default(0) @db.Decimal(12, 2)
  /// 累计已冲正金额（结算币种），与 reversedAmount 同步推进
  reversedSettle Decimal          @default(0) @db.Decimal(12, 2)
  /// 受益人快照（用户注销后仍可对账；姓名/邮箱是当时的展示值）
  toUserName     String?
  toUserEmail    String?
  createdAt      DateTime         @default(now())
  settledAt      DateTime?
  reversedAt     DateTime?
  note           String?

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  toUser   User? @relation("CommissionBeneficiary", fields: [toUserId], references: [id], onDelete: SetNull)
  fromUser User? @relation("CommissionSource", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@unique([orderId, toUserId, level])
  @@index([orderId])
  @@index([toUserId, status, createdAt])
  @@index([status, createdAt])
  /// 风控自购检测（90 天窗口倒序）/ 报表按时间过滤：单列时间索引支撑，
  /// 此前风控 SQL 无命中时全表扫 100 万行（性能审计中危）。
  @@index([createdAt])
  @@map("commission_logs")
}

/// 分销商账户。所有金额都由 `commission_logs` / `withdraw_records` 汇总而来，
/// 本表只是**物化汇总**，便于列表页与提现校验；对账不一致时以流水为准。
/// 余额的币种 = `settlementCurrency`（账户级结算币种，分销客自选，默认 CNY，
/// 让非人民币区域的分销客不必被迫接受 CNY 结算）。
model DistributorAccount {
  userId             String    @id
  /// 分销商等级（0=普通，1..N 越高越优）；等级可命中差异化佣金规则
  tier               Int       @default(0)
  /// 首次确认《分销规则》的时间（提现前必须确认；合规留痕）
  termsAcceptedAt    DateTime?
  /// 结算币种（佣金入账与提现的记账币种；默认 CNY 与历史口径兼容）
  settlementCurrency String    @default("CNY")
  /// 可提现余额（按 settlementCurrency 计价）
  balance            Decimal   @default(0) @db.Decimal(12, 2)
  /// 提现冻结（已申请未打款）
  frozen             Decimal   @default(0) @db.Decimal(12, 2)
  /// 累计已结算佣金（含已提现）
  totalCommission    Decimal   @default(0) @db.Decimal(12, 2)
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([balance])
  @@map("distributor_accounts")
}

// ============ 货币配置 ============

/// 支持币种配置（后台「货币与汇率」可增删）。
/// 前台币种选择器 = enabled 列表；payable 控制是否允许**以该币种下单支付**
///（展示换算用的币种可以关掉支付：例如面向欧美市场的站点可展示 CNY 换算
/// 但不允许以 CNY 结账 —— 结算与展示解耦）。
model CurrencyConfig {
  id        String   @id @default(cuid())
  /// ISO 4217 货币代码，全站唯一
  code      String   @unique
  /// 展示名（英文，如 US Dollar）
  name      String
  /// 展示国家/地区名（如 United States / Eurozone）
  country   String
  symbol    String
  /// Intl 格式化用的 BCP 47 locale
  locale    String
  /// ISO 3166-1 alpha-2 小写 —— 国旗图取 public/flags/<flagCode>.svg
  flagCode  String
  /// 是否出现在前台币种选择器（关闭后仅保留已选用户的展示兼容）
  enabled   Boolean  @default(true)
  /// 是否允许以该币种下单支付（关闭则下单/结账校验拒绝）
  payable   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currency_configs")
}

/// 提现单。默认口径：申请 → 平台审核 → **线下打款** → 标记已打款。
/// 一期不接自动代付（需主体资质 + KYC + 代扣个税），故 `payNote` 记录线下凭证号。
model WithdrawRecord {
  id          String         @id @default(cuid())
  /// 可空 + SetNull：用户注销后提现记录必须留存（打款凭证与个税凭证）
  userId      String?
  /// 申请人邮箱快照（用户删除后仍可追溯）
  userEmail   String?
  /// 收款人实名（KYC，可选填写；线下打款核对用）
  payeeName   String?
  /// 收款方式：bank | alipay | wechat | other
  payeeMethod String?
  /// 申请金额（币种 = 账户结算币种，见 currency 字段）
  amount      Decimal        @db.Decimal(10, 2)
  /// 提现币种（账户 settlementCurrency 的申请时快照）
  currency    String         @default("CNY")
  /// 申请金额折 CNY（申请时汇率快照固化，管理端总览跨币种合计用 —— 币种混算
  /// 修复 2026-09-26：此前总览把不同结算币种的 amount 直接相加当 CNY 展示，
  /// USD 分销商的 $100 会被当成 ¥100 计入待打款合计）
  amountCny   Decimal        @default(0) @db.Decimal(12, 2)
  status      WithdrawStatus @default(PENDING)
  /// 收款账户信息（展示时脱敏）
  accountInfo String?
  /// 申请备注
  remark      String?
  /// 审核/打款备注
  auditNote   String?
  /// 打款凭证号（线下转账流水号）
  payNote     String?
  auditedById String?
  auditedAt   DateTime?
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditedBy User? @relation("WithdrawAuditor", fields: [auditedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("withdraw_records")
}

/// 订单归属快照：下单那一刻把「归谁」固化下来。
/// 事后解绑/换绑都不影响历史订单的佣金归属（可追溯、可对账）。
model OrderAttribution {
  orderId              String   @id
  /// 归属分销商；null=自然流量订单（不参与分佣）
  distributorId        String?
  /// 下单时的关系链快照：JSON 数组 [{ userId, depth }]，从归属分销商向上
  relationPathSnapshot Json?
  /// 下单归属时命中的完整规则与配置快照；历史数据缺失时计佣仅兼容回退实时读取。
  ruleSnapshot         Json?
  bindId               String?
  /// 是否自然流量（显式落库，报表按此统计「未归属订单」）
  natural              Boolean  @default(false)
  createdAt            DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([distributorId, createdAt])
  @@index([natural, createdAt])
  @@map("order_attributions")
}

/// 调度器租约（2026-09-26 长事务重构）：单行表，多实例抢租约执行心跳任务。
/// 此前整轮任务（含 Stripe 网络调用）包在最长 5 分钟的**事务**里持咨询锁 ——
/// 常驻占 1 个连接池连接 + 每分钟的长事务阻碍 autovacuum 回收死元组
/// （orders/commission_logs 高频更新表投产后表膨胀风险）。租约模式下：
/// 短事务抢锁（毫秒级）→ 任务在**事务外**执行，崩溃后租约自然过期，
/// 其他实例下轮接管。
model SchedulerLease {
  id          Int      @id @default(1)
  /// 租约到期时间；到期后任何实例可抢占
  lockedUntil DateTime
  /// 当前持有者标识（实例随机 id，仅排障用）
  holder      String?
  updatedAt   DateTime @updatedAt

  @@map("scheduler_lease")
}
