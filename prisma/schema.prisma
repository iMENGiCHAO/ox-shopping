// Prisma Schema — 生产级电商数据模型
// 说明：在需求模型基础上补充了三个支撑模型：
//   RefreshToken —— JWT refresh token 轮换与重放检测
//   Favorite      —— 商品收藏（个人中心“收藏”功能）
//   SiteSetting   —— 管理端“设置”页面持久化（站点名称、SEO 等）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

enum Role {
  ADMIN
  CUSTOMER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

// ============ 用户 ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  addresses  Address[]
  cartItems  CartItem[]
  orders     Order[]         @relation("UserOrders")
  assignedOrders Order[]     @relation("OrderAssignee")
  reviews    Review[]
  favorites  Favorite[]
  coupons    CouponRedemption[]
  refunds    Refund[]
  auditLogs  AuditLog[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  priceAlerts PriceAlert[]

  @@index([status])
  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  recipientName String
  phone        String
  province     String
  city         String
  district     String
  detail       String
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256(refresh token)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String? // 轮换后指向新 token id，用于重放检测

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============ 商品 ============

model Category {
  id        String  @id @default(cuid())
  name      String  // zh (fallback when nameEn is null)
  nameEn    String? // optional English name
  slug      String  @unique
  description String?
  image     String?
  /// 落地页顶部全宽大横幅(与列表卡片 image 相互独立)
  bannerImage String?
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  name          String  // zh (fallback when nameEn is null)
  nameEn        String? // optional English name
  slug          String        @unique
  description   String  // zh description
  descriptionEn String? // optional English description
  sku           String        @unique
  price         Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?     @db.Decimal(10, 2)
  costPrice     Decimal?      @db.Decimal(10, 2)
  stock         Int           @default(0)
  soldCount     Int           @default(0)
  /// 预售：售罄后仍可下单（Pre-Order），前台展示预售标签
  isPresale     Boolean       @default(false)
  /// 预售提示文案（多语言，可选）。为空时使用站级默认（SiteSetting: presale_note_zh/en）。
  presaleNoteZh String?
  presaleNoteEn String?
  /// 运营标签：新品上市 / 热卖（前台徽标）
  isNew         Boolean       @default(false)
  isHot         Boolean       @default(false)
  /// 尺码参数表（官方 Size Chart）：{ headers: string[]; rows: string[][] }
  sizeChart     Json?
  /// 规格级库存：{ "Size": { "S": 3, "M": 0 } }，值为 0 = 该规格售罄
  specStock     Json?
  images        Json          @default("[]") // string[]
  attributes    Json          @default("[]") // { name: string; values: string[] }[]
  status        ProductStatus @default(DRAFT)
  categoryId    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category   Category     @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  priceAlerts PriceAlert[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, createdAt])
  @@index([price])
  @@map("products")
}

// ============ 购物车 ============

model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  // 下单规格快照（[{ name, value }]，如颜色=曜石黑）
  attributes    Json?
  // 规格去重键（规范化 JSON，用于区分同商品不同规格的购物车行）
  attributesKey String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, attributesKey])
  @@index([userId])
  @@map("cart_items")
}

// ============ 订单 ============

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("CNY")
  addressSnapshot Json // { recipientName, phone, province, city, district, detail }
  paymentProvider String? // stripe | mock
  paymentId       String? // Stripe PaymentIntent id
  // 支付会话 ID（Stripe Checkout Session，掉单对账用预留字段；mock 模式为空）
  paymentSessionId String?
  trackingCompany String?
  trackingNumber  String?
  note            String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  // 物流方式（多对多 1：实际选一种；后台管理；nullable=沿用默认值）
  shippingMethodId String?
  // 运费到付（货到付款）时为 true，shippingFee 仅作占位记录
  isCashOnDelivery Boolean   @default(false)
  // 运营节点：被某个 admin/support 认领处理（防止多端重复处理 / 漏处理）
  assigneeId       String?
  assignedAt       DateTime?
  // 新订单提醒：true = 还没被任何人看过，admin 进入 /orders 列表后自动取消
  isUnread         Boolean   @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user           User              @relation("UserOrders", fields: [userId], references: [id])
  items          OrderItem[]
  redemptions    CouponRedemption[]
  refunds        Refund[]
  shippingMethod ShippingMethod?   @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  assignee       User?             @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orderNumber])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([paymentId])
  @@index([paymentSessionId])
  @@index([assigneeId])
  @@index([isUnread, status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  // 下单规格快照（[{ name, value }]）
  attributes   Json?
  sku          String
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)
  // 实际从商品库存扣减的数量（预售可少于 quantity，取消时精确回补）
  stockDeducted Int    @default(0)
  // 实际从规格库存(specStock)扣减的映射 { "组名/值": n }（取消时精确回补）
  specDeducted  Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============ 评价 ============

model Review {
  id                 String   @id @default(cuid())
  userId             String
  productId          String
  orderItemId        String?  @unique
  rating             Int // 1-5
  title              String?
  comment            String
  images             Json     @default("[]")
  isVerifiedPurchase Boolean  @default(true)
  isHidden           Boolean  @default(false)
  createdAt          DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, isHidden, createdAt])
  @@index([userId])
  @@map("reviews")
}

// ============ 收藏 ============

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  /// 收藏时浏览器的语种（zh/en），用于按用户原语种发降价通知邮件
  lang      String?
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAlert PriceAlert?

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

// ============ 优惠券 ============

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2) // 百分比(0-100) / 固定金额 / 0
  minSpend    Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscount Decimal?   @db.Decimal(10, 2)
  startsAt    DateTime
  endsAt      DateTime
  usageLimit  Int        @default(0) // 0 = 不限
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  // 每位用户每张券限用一次（防重复薅羊毛）
  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ============ 退款 ============

model Refund {
  id        String       @id @default(cuid())
  orderId   String
  userId    String
  reason    String
  amount    Decimal      @db.Decimal(10, 2)
  status    RefundStatus @default(REQUESTED)
  adminNote String?
  // 支付网关退款单号（Stripe refund.id；mock 为空）
  gatewayRefundId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
  @@index([userId])
  @@map("refunds")
}

// ============ 审计日志 ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============ 站点设置 ============

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// 支付/退款流水日志（资金对账审计；只追加，不修改）
model PaymentLog {
  id        String   @id @default(cuid())
  orderId   String?
  provider  String // stripe | mock
  /// paid | checkout_created | refund_requested | refunded | refund_rejected | reconcile_paid
  event     String
  amount    Decimal? @db.Decimal(10, 2)
  /// 网关侧单号（payment intent / checkout session / refund id）
  gatewayId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([event, createdAt])
  @@map("payment_logs")
}

/// 到货通知（售罄商品 PDP 的 Notify me 订阅）
model NotifyMe {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(254)
  productId String?
  /// 客户选中的规格（如 {"Color":"Black","Size":"M"}）——补货按变体提醒
  attributes Json?
  status    String    @default("draft") // draft=待通知 notified=已通知
  notifiedAt DateTime?
  /// 订阅时浏览器的语种（"zh" | "en"），用于按用户原语种发到货通知邮件；nullable=未记录
  lang      String?
  createdAt DateTime  @default(now())

  @@unique([email, productId])
  @@index([createdAt])
  @@map("notify_me")
}

/// FAQ 常见问题（后台「FAQ 管理」维护，前台 /pages/faqs 读取）
model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(200)
  answer    String   @db.Text
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// 物流方式（后台「设置 → 物流方式」维护；前台 checkout 选项）
model ShippingMethod {
  id        String   @id @default(cuid())
  /// 后台唯一代号（默认 "standard" / "express"；自定义如 "sf-next-day"）
  code      String   @unique
  /// 显示名（zh fallback when nameEn is null）
  name      String
  nameEn    String?
  /// 简介（多语）
  description String?
  descriptionEn String?
  /// 基础运费（统一币种，与 env.CURRENCY 挂钩）
  fee       Decimal  @db.Decimal(10, 2) @default(0)
  /// 满 X 金额免运费（0 = 不免邮）
  freeOver  Decimal  @db.Decimal(10, 2) @default(0)
  /// 是否到付（到付订单：fee 不计入 total，到付金额另算）
  isCashOnDelivery Boolean @default(false)
  /// 排序（小的在前）
  sortOrder Int      @default(0)
  /// 是否启用
  isActive  Boolean  @default(true)
  /// 估计送达时间（zh / en 多语）
  etaZh     String?
  etaEn     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([isActive, sortOrder])
  @@map("shipping_methods")
}

/// 站内消息中心（个人中心"消息"页 + 顶栏角标）
///  - type: order | refund | price_alert | system
///  - 多语 title/body（zh fallback） + 客户 lang 切换显示
///  - unread=true 时算入角标；客户点开后自动 mark read
model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// 消息类型：order | refund | price_alert | system
  type      String
  /// 标题（zh fallback）
  title     String
  titleEn   String?
  /// 正文（多语；前端按 lang 字段选择）
  body      String
  bodyEn    String?
  /// 跳转链接（绝对/相对）
  link      String?
  /// 元数据（订单号、退款 id、商品 id 等）
  meta      Json?
  isUnread  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUnread])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// 降价通知（与 Favorite 1:1：收藏 = 关注 = 降价通知订阅）
/// 不存 email — 收件人直接从 User.email 拿
model PriceAlert {
  id        String   @id @default(cuid())
  favoriteId String  @unique // 一对一：每个 favorite 自动对应一个 price_alert
  productId String
  userId    String
  /// 已通知价（最新一次通知时的价格，避免重复发同一价位邮件）
  notifiedAt   DateTime?
  notifiedPrice Decimal? @db.Decimal(10, 2)
  /// 订阅时浏览器的语种（zh/en），用于按用户原语种发降价通知邮件
  lang      String?
  /// true=已取消订阅（保留记录以便追溯；UI 不显示）
  unsubscribed Boolean @default(false)
  createdAt DateTime @default(now())

  favorite  Favorite  @relation(fields: [favoriteId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, unsubscribed])
  @@index([userId])
  @@map("price_alerts")
}

